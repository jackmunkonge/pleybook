# Neon Postgres (pooled connection string)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# LLM providers (set model IDs after checking AI Studio / Groq console)
GOOGLE_GENERATIVE_AI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
COHERE_API_KEY=
PRIMARY_MODEL=
FALLBACK_MODEL=
OPENROUTER_MODEL=
EMBED_MODEL=gemini-embedding-001
EMBED_DIM=768

# Max reviews per user per rolling 24h
DAILY_REVIEW_LIMIT=5

# Clauses reviewed per contract; longer documents are truncated with a notice
MAX_CLAUSES_PER_REVIEW=50

# Better Auth (generate secret with: openssl rand -base64 32)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
